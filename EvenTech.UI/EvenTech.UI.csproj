<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>EvenTech.UI</RootNamespace>
    <AssemblyName>EvenTech.UI</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Identidad del ejecutable instalado. La version, el producto y la empresa son de
         toda la solucion (Directory.Build.props), y el commit lo agrega
         Directory.Build.targets. El icono es el de los accesos directos, del menu Inicio
         y de "Aplicaciones instaladas". -->
    <AssemblyTitle>EvenTech</AssemblyTitle>
    <ApplicationIcon>Assets\eventech.ico</ApplicationIcon>
    <!-- Sin conciencia de DPI. Todas las pantallas estan dimensionadas en pixeles de
         96 DPI: con PerMonitorV2 las letras crecian con la escala de Windows y el layout
         no, y a 125/150 % quedaban textos, campos y botones cortados. Asi Windows dibuja
         la ventana a 96 DPI y la escala entera: el layout es el mismo en cualquier escala
         (algo menos nitido). Se descarto DpiUnawareGdiScaled: el sistema vuelve a dibujar
         el texto con la letra al doble, las medidas no escalan lineal (hasta 14 px mas en
         Ebrima 9 pt) y lo que entra justo a 96 DPI quedaba recortado. -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- Isologotipo del sistema: viaja embebido en el ensamblado, sin archivos
         sueltos que se puedan perder al copiar la aplicacion. -->
    <EmbeddedResource Include="Assets\logo_eventech.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EvenTech.BE\EvenTech.BE.csproj" />
    <ProjectReference Include="..\EvenTech.BLL\EvenTech.BLL.csproj" />
    <ProjectReference Include="..\EvenTech.Services\EvenTech.Services.csproj" />
  </ItemGroup>
</Project>
